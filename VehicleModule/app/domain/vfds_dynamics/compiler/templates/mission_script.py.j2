async def run_mission(connection_str: str = None, grpc_port: int = None):
    """메인 미션 실행 함수"""
    if connection_str is None:
        connection_str = CONNECTION_STRING_DEFAULT

    # MAVSDK System 초기화 (gRPC 포트 중복 방지)
    drone = System(port=grpc_port) if grpc_port else System()
    
    print(f"[INIT] Connecting to {connection_str} (gRPC: {grpc_port or 'default'})...")
    sys.stdout.flush()
    await drone.connect(system_address=connection_str)
    print(f"[INIT] Telemetry endpoints: {', '.join(VFDS_URLS)}")

    # 연결 대기
    print("[INIT] Waiting for drone connection...")
    async for state in drone.core.connection_state():
        if state.is_connected:
            print("[INIT] Drone connected!")
            break

    # GPS 수신 대기
    print("[INIT] Waiting for GPS fix...")
    reporter = Reporter(drone)
    reporter.start()
    await reporter.report_event("WAITING", "CONNECTED", 0)

    if not await wait_for_global_position(drone, reporter):
        reporter.stop()
        return

    await reporter.report_event("READY_WAITING", "WAIT_ARM", 0)
    await wait_for_simulation_time(MISSION_ARM_TIME, reason="arming time")
    await wait_for_stable_attitude(drone)

    # ARM
    print("[ARM] Arming drone...")
    for attempt in range(5):
        try:
            await drone.action.arm()
            print("[ARM] Armed.")
            break
        except Exception as e:
            print(f"[ARM] Arming failed (attempt {attempt+1}): {e}")
            await asyncio.sleep(2)
    else:
        print("[ARM] Failed to arm after 5 attempts. Exiting.")
        await reporter.report_event("FAILED", "ARM_FAILED", 0)
        reporter.stop()
        return

    await reporter.report_event("ARMED_WAITING", "ARM", 0)
    await reporter.refresh_telemetry_rates("after arm")
    await wait_for_simulation_time(MISSION_START_TIME, reason="mission start")
    await reporter.refresh_telemetry_rates("before mission start")
    await reporter.report_event("EXECUTING", "START", 0)

    try:
        _is_fw_mode = False  # FW 모드 추적
{% for leg in ir.legs %}
        # ── Seq {{ leg.seq }}: Phase {{ leg.phase }} — {{ leg.description }} ──
        await reporter.report_event("EXECUTING", "{{ leg.phase }}", {{ leg.seq }})
{% if leg.leg_type.value == "VTOL_CLIMB" %}
        print("[SEQ {{ leg.seq }}] Phase {{ leg.phase }}: {{ leg.description }}")
        if not await do_takeoff(drone, target_alt={{ leg.end_alt }}):
            raise RuntimeError("TAKEOFF_FAILED_OR_TIMEOUT")
        if not await do_goto_line(
            drone,
            start_lat={{ leg.start_lat }}, start_lon={{ leg.start_lon }},
            end_lat={{ leg.end_lat }}, end_lon={{ leg.end_lon }},
            alt={{ leg.end_alt }}, speed={{ leg.target_speed }},
            heading={{ leg.heading_deg|round(1) if leg.heading_deg is not none else 'None' }},
            threshold=POSITION_REACHED_THRESHOLD_M
        ):
            raise RuntimeError("CLIMB_GOTO_FAILED_OR_TIMEOUT")
{% elif leg.leg_type.value == "VTOL_DESCENT" %}
        print("[SEQ {{ leg.seq }}] Phase {{ leg.phase }}: {{ leg.description }}")
        await do_land(drone)
{% elif leg.leg_type.value == "RF_ARC" %}
        print("[SEQ {{ leg.seq }}] Phase {{ leg.phase }}: {{ leg.description }} (R={{ leg.radius_m|round(0)|int }}m, {{ leg.turn_direction }}, sweep={{ (leg.sweep_rad * 57.2958)|round(1) }}°)")
{% if leg.arc_warning %}
        print("  [WARNING] {{ leg.arc_warning }}")
{% endif %}
        await do_orbit_arc(
            drone,
            center_lat={{ leg.center_lat }}, center_lon={{ leg.center_lon }},
            center_alt={{ leg.center_alt }},
            radius_m={{ leg.radius_m|round(1) }}, speed={{ leg.target_speed }},
            turn_direction="{{ leg.turn_direction }}",
            sweep_rad={{ leg.sweep_rad|round(4) }},
            start_lat={{ leg.start_lat }}, start_lon={{ leg.start_lon }},
            end_lat={{ leg.end_lat }}, end_lon={{ leg.end_lon }},
            end_alt={{ leg.end_alt }},
        )
{% elif leg.leg_type.value == "TRANSITION_FW" %}
        print("[SEQ {{ leg.seq }}] Phase {{ leg.phase }}: {{ leg.description }}")
        if not await do_transition_fw(
            drone,
            end_lat={{ leg.end_lat }}, end_lon={{ leg.end_lon }},
            alt={{ leg.end_alt }}, speed={{ leg.target_speed }},
            start_lat={{ leg.start_lat }}, start_lon={{ leg.start_lon }},
            heading={{ leg.heading_deg|round(1) if leg.heading_deg is not none else 'None' }},
        ):
            raise RuntimeError("TRANSITION_FW_FAILED_OR_TIMEOUT")
        _is_fw_mode = True
{% elif leg.leg_type.value == "TRANSITION_MC" %}
        print("[SEQ {{ leg.seq }}] Phase {{ leg.phase }}: {{ leg.description }}")
        if not await do_transition_mc(
            drone,
            end_lat={{ leg.end_lat }}, end_lon={{ leg.end_lon }},
            alt={{ leg.end_alt }}, speed={{ leg.target_speed }},
            start_lat={{ leg.start_lat }}, start_lon={{ leg.start_lon }},
            heading={{ leg.heading_deg|round(1) if leg.heading_deg is not none else 'None' }},
        ):
            raise RuntimeError("TRANSITION_MC_FAILED_OR_TIMEOUT")
        _is_fw_mode = False
{% elif leg.leg_type.value == "TAXI" %}
        print("[SEQ {{ leg.seq }}] Phase {{ leg.phase }}: {{ leg.description }} (skipped - ground taxi)")
{% elif leg.leg_type.value == "TF_LINE" %}
        print("[SEQ {{ leg.seq }}] Phase {{ leg.phase }}: {{ leg.description }}")
        if not await do_goto_line(
            drone,
            start_lat={{ leg.start_lat }}, start_lon={{ leg.start_lon }},
            end_lat={{ leg.end_lat }}, end_lon={{ leg.end_lon }},
            alt={{ leg.end_alt }}, speed={{ leg.target_speed }},
            heading={{ leg.heading_deg|round(1) if leg.heading_deg is not none else 'None' }},
            threshold=FW_POSITION_REACHED_THRESHOLD_M if _is_fw_mode else None,
        ):
            raise RuntimeError("GOTO_LINE_FAILED_OR_TIMEOUT")
{% endif %}

{% endfor %}
    except Exception as e:
        print(f"[ERROR] Mission failed: {e}")
        await reporter.report_event("FAILED", str(e), 0)
        await emergency_land(drone, connection_str=connection_str, grpc_port=grpc_port)
        reporter.stop()
        return

    print("[DONE] Mission FP{{ ir.flight_plan_number }} completed successfully.")
    await reporter.report_event("COMPLETED", "DONE", 999)
    reporter.stop()


if __name__ == "__main__":
    parser = argparse.ArgumentParser(description="MAVSDK Mission Script")
    parser.add_argument("--connection", type=str, help="MAVLink connection string (e.g. udpin://0.0.0.0:14540)")
    parser.add_argument("--grpc-port", type=int, help="MAVSDK gRPC server port (e.g. 50051)")
    args = parser.parse_args()

    asyncio.run(run_mission(connection_str=args.connection, grpc_port=args.grpc_port))
