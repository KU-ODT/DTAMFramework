async def wait_for_global_position(drone, reporter, timeout_sec: float = 90.0) -> bool:
    """Wait for GPS/home position, while still publishing connection status."""
    import grpc
    print(f"[INIT] Waiting for GPS fix (timeout: {timeout_sec:.0f}s)...")
    loop = asyncio.get_running_loop()
    deadline = loop.time() + timeout_sec
    last_wait_log = 0.0
    try:
        health_stream = drone.telemetry.health()
        while True:
            remaining = deadline - loop.time()
            if remaining <= 0:
                print("[ERROR] GPS fix timeout. Mission will not arm.")
                await reporter.report_event("FAILED", "GPS_TIMEOUT", 0)
                return False

            try:
                health = await asyncio.wait_for(
                    health_stream.__anext__(),
                    timeout=min(2.0, remaining),
                )
            except asyncio.TimeoutError:
                now = loop.time()
                if now - last_wait_log >= 10.0:
                    print(
                        f"[INIT] Still waiting for GPS/home telemetry... "
                        f"({max(0.0, deadline - now):.0f}s left)"
                    )
                    last_wait_log = now
                continue

            if health.is_global_position_ok and health.is_home_position_ok:
                print("[INIT] GPS fix acquired.")
                await reporter.report_event("WAITING", "GPS_READY", 0)
                return True
    except grpc.aio.AioRpcError as e:
        print(f"[ERROR] GPS health stream error: {e.code().name}")
    except Exception as e:
        print(f"[ERROR] GPS health check error: {e}")

    await reporter.report_event("FAILED", "GPS_ERROR", 0)
    return False

