def _detect_vfds_urls() -> list[str]:
    urls: list[str] = []

    def add_url(url: str):
        normalized = url.strip().rstrip("/")
        if normalized and normalized not in urls:
            urls.append(normalized)

    # 1순위: 컴파일 타임에 주입된 VFDS Host (가장 확실함)
    add_url("http://{{ ir.vfds_host }}:8000")

    try:
        import subprocess
        # WSL/VM 환경을 위한 게이트웨이 감지
        gateway = subprocess.check_output(
            ["sh", "-lc", "ip route show default 2>/dev/null | awk '/default/ {print $3; exit}'"],
            text=True,
        ).strip()
        if gateway:
            add_url(f"http://{gateway}:8000")
    except Exception:
        pass

    # 환경 변수 및 로컬 주소 (Fallback)
    env_url = os.getenv("VFDS_URL", "").strip()
    if env_url:
        add_url(env_url)

    env_host = os.getenv("VFDS_HOST", "").strip()
    if env_host:
        env_port = os.getenv("VFDS_PORT", "8000").strip() or "8000"
        add_url(f"http://{env_host}:{env_port}")

    add_url("http://localhost:8000")
    add_url("http://127.0.0.1:8000")

    try:
        with open("/etc/resolv.conf", "r", encoding="utf-8") as resolv_conf:
            for line in resolv_conf:
                if line.startswith("nameserver "):
                    host_ip = line.split()[1].strip()
                    if host_ip:
                        add_url(f"http://{host_ip}:8000")
                    break
    except OSError:
        pass

    return urls


VFDS_URLS = _detect_vfds_urls()
