def _lla_to_ned(lat_deg: float, lon_deg: float, alt_m: float) -> dict[str, float]:
    """LLA 좌표를 HOME 기준 NED(North, East, Down) 미터 단위로 변환한다."""
    # GPS Fix가 제대로 되지 않아 0,0으로 들어오는 경우 보호
    if abs(lat_deg) < 0.1 or abs(lon_deg) < 0.1:
        return {"north": 0.0, "east": 0.0, "down": 0.0}

    # 지구 반경 (WGS84)
    R = 6378137.0
    
    d_lat = math.radians(lat_deg - HOME_LAT)
    d_lon = math.radians(lon_deg - HOME_LON)
    
    # 단순 평면 투영 (Small distance approximation)
    north_m = d_lat * R
    east_m = d_lon * R * math.cos(math.radians(HOME_LAT))
    down_m = HOME_ALT - alt_m
    
    # 디버깅용 (처음 몇 번만 출력)
    if not hasattr(_lla_to_ned, "_logged"):
        print(f"[DEBUG] LLA: ({lat_deg}, {lon_deg}) | HOME: ({HOME_LAT}, {HOME_LON}) -> NED North: {north_m}")
        _lla_to_ned._logged = True

    return {
        "north": round(north_m, 2),
        "east": round(east_m, 2),
        "down": round(down_m, 2),
    }

# ──────────────────────── Reporter (Telemetry & Events) ────────────────
class Reporter:
    STREAM_RETRY_DELAY = 3.0

    def __init__(self, drone: System):
        self.drone = drone
        self._vfds_urls = list(VFDS_URLS)
        self._active_vfds_url = self._vfds_urls[0]
        self._last_report_error = None
        self.state = {
            "missionState": "WAITING",
            "phase": "N/A",
            "seq": 0,
            "position": {"lat": 0.0, "lon": 0.0, "alt": 0.0, "north": 0.0, "east": 0.0, "down": 0.0},
            "attitude": {"roll": 0.0, "pitch": 0.0, "yaw": 0.0},
            "velocityNed": {"north": 0.0, "east": 0.0, "down": 0.0},
            "speedMps": 0.0,
            "actuator": {},
            "motorRpm": [0.0, 0.0, 0.0, 0.0],
        }
        self._last_esc_rpm_at = 0.0
        self._last_motor_rpm_at = 0.0
        self.running = False
        
    def _send_sync(self, endpoint: str, payload: dict):
        candidates = [self._active_vfds_url] + [
            url for url in self._vfds_urls if url != self._active_vfds_url
        ]
        last_error = None
        body = json.dumps(payload).encode('utf-8')

        for base_url in candidates:
            req = urllib.request.Request(
                f"{base_url}{endpoint}",
                data=body,
                headers={'Content-Type': 'application/json'}
            )
            try:
                urllib.request.urlopen(req, timeout=1.0)
                if self._active_vfds_url != base_url:
                    print(f"[REPORTER] Switched telemetry endpoint to {base_url}")
                self._active_vfds_url = base_url
                self._last_report_error = None
                return
            except Exception as exc:
                last_error = f"{base_url}: {exc}"

        try:
            import subprocess

            ps_result = subprocess.run(
                [
                    "powershell.exe",
                    "-NoProfile",
                    "-Command",
                    (
                        f"$input | Invoke-RestMethod -Method Post "
                        f"-Uri 'http://127.0.0.1:8000{endpoint}' "
                        "-ContentType 'application/json' | Out-Null"
                    ),
                ],
                input=body.decode("utf-8"),
                capture_output=True,
                text=True,
                timeout=2.0,
            )
            if ps_result.returncode == 0:
                if self._active_vfds_url != "http://127.0.0.1:8000":
                    print("[REPORTER] Routed telemetry via Windows PowerShell bridge")
                self._active_vfds_url = "http://127.0.0.1:8000"
                self._last_report_error = None
                return
            ps_error = (ps_result.stderr or ps_result.stdout).strip()
            if ps_error:
                last_error = f"powershell bridge: {ps_error}"
        except Exception as exc:
            if last_error is None:
                last_error = f"powershell bridge: {exc}"

        if last_error and last_error != self._last_report_error:
            self._last_report_error = last_error
            print(f"[REPORTER] Telemetry send failed: {last_error}")

    async def report_event(self, event_name: str, phase: str, seq: int):
        self.state["missionState"] = event_name
        self.state["phase"] = phase
        self.state["seq"] = seq
        
        payload = {
            "type": "MISSION_EVENT",
            "aircraftId": AIRCRAFT_ID,
            "flightPlanNumber": FLIGHT_PLAN_NUMBER,
            "seq": seq,
            "phase": phase,
            "event": event_name,
            "ts": datetime.now(timezone.utc).isoformat()
        }
        await asyncio.get_running_loop().run_in_executor(None, self._send_sync, "/api/v1/events", payload)

    async def _configure_telemetry_rates(self):
        """Request the telemetry streams used by the dashboard."""
        try:
            await self.drone.telemetry.set_rate_position(10.0)
            await self.drone.telemetry.set_rate_attitude_euler(10.0)
            await self.drone.telemetry.set_rate_position_velocity_ned(10.0)
            await self.drone.telemetry.set_rate_actuator_output_status(10.0)
        except Exception as e:
            print(f"[REPORTER] Telemetry rate setup warning: {e}")

    async def refresh_telemetry_rates(self, reason: str = "manual"):
        print(f"[REPORTER] Refreshing telemetry rates ({reason})...")
        await self._configure_telemetry_rates()

    async def _sub_position(self):
        """텔레메트리 위치 스트림 구독 (자동 재연결 포함)."""
        import grpc
        retries = 0
        while self.running:
            try:
                async for pos in self.drone.telemetry.position():
                    if not self.running:
                        return
                    ned = _lla_to_ned(
                        pos.latitude_deg,
                        pos.longitude_deg,
                        pos.absolute_altitude_m,
                    )
                    self.state["position"] = {
                        "lat": pos.latitude_deg,
                        "lon": pos.longitude_deg,
                        "alt": pos.absolute_altitude_m,
                        "north": ned["north"],
                        "east": ned["east"],
                        "down": ned["down"],
                    }
                    retries = 0  # 정상 수신 시 카운터 리셋
            except grpc.aio.AioRpcError as e:
                retries += 1
                if self.running:
                    print(f"[REPORTER] Position stream lost ({e.code().name}), retry {retries} in {self.STREAM_RETRY_DELAY}s...")
                    await asyncio.sleep(self.STREAM_RETRY_DELAY)
            except Exception as e:
                retries += 1
                if self.running:
                    print(f"[REPORTER] Position stream error: {e}, retry {retries}...")
                    await asyncio.sleep(self.STREAM_RETRY_DELAY)

    async def _sub_velocity(self):
        """Telemetry NED velocity stream subscription for speed/track display."""
        import grpc
        retries = 0
        while self.running:
            try:
                async for vel in self.drone.telemetry.position_velocity_ned():
                    if not self.running:
                        return
                    velocity = vel.velocity
                    north = float(getattr(velocity, "north_m_s", 0.0))
                    east = float(getattr(velocity, "east_m_s", 0.0))
                    down = float(getattr(velocity, "down_m_s", 0.0))
                    self.state["velocityNed"] = {"north": north, "east": east, "down": down}
                    self.state["speedMps"] = math.sqrt(north * north + east * east + down * down)
                    retries = 0
            except grpc.aio.AioRpcError as e:
                retries += 1
                if self.running:
                    if retries == 1 or retries % 10 == 0:
                        print(f"[REPORTER] Velocity stream lost ({e.code().name}), retrying...")
                    await asyncio.sleep(self.STREAM_RETRY_DELAY)
            except Exception as e:
                retries += 1
                if self.running:
                    if retries == 1 or retries % 10 == 0:
                        print(f"[REPORTER] Velocity stream error: {e}, retrying...")
                    await asyncio.sleep(self.STREAM_RETRY_DELAY)

    async def _sub_attitude(self):
        """텔레메트리 자세 스트림 구독 (라디안 변환 포함, 자동 재연결 포함)."""
        import grpc
        retries = 0
        while self.running:
            try:
                async for att in self.drone.telemetry.attitude_euler():
                    if not self.running:
                        return
                    # Dashboard expects degrees for simple display
                    self.state["attitude"] = {
                        "roll":  att.roll_deg,
                        "pitch": att.pitch_deg,
                        "yaw":   att.yaw_deg,
                    }
                    retries = 0
            except grpc.aio.AioRpcError as e:
                retries += 1
                if self.running:
                    print(f"[REPORTER] Attitude stream lost ({e.code().name}), retry {retries} in {self.STREAM_RETRY_DELAY}s...")
                    await asyncio.sleep(self.STREAM_RETRY_DELAY)
            except Exception as e:
                retries += 1
                if self.running:
                    print(f"[REPORTER] Attitude stream error: {e}, retry {retries}...")
                    await asyncio.sleep(self.STREAM_RETRY_DELAY)

    async def _sub_actuator(self):
        """액추에이터 출력 스트림 구독 — PX4 서보 채널을 ICD 필드로 매핑하고, 모터 RPM도 추출한다."""
        import grpc
        retries = 0
        while self.running:
            try:
                async for act in self.drone.telemetry.actuator_output_status():
                    if not self.running:
                        return
                    ch = act.actuator  # PWM μs 리스트 (채널 0-based)
                    def _pwm01(idx):   # 1000~2000 μs → 0.0~1.0
                        return max(0.0, min(1.0, (ch[idx] - 1000) / 1000)) if idx < len(ch) else 0.0
                    def _pwmdeg(idx, max_deg=30.0):  # 1500 μs=중립 → ±deg
                        return max(-max_deg, min(max_deg, (ch[idx] - 1500) / 500 * max_deg)) if idx < len(ch) else 0.0
                    # PX4 VTOL 틸트로터 기본 채널 매핑 (0-based: servo5=idx4, servo6=idx5 ...)
                    self.state["actuator"] = {
                        "tilt_left":    _pwm01(4),
                        "tilt_right":   _pwm01(5),
                        "aileron":      _pwmdeg(6),
                        "rudder_left":  _pwmdeg(8),
                        "rudder_right": _pwmdeg(9),
                    }
                    # 모터 RPM 추출 (채널 0-3, PWM 1000-2000 → RPM 0~10000 환산)
                    # 항상 갱신 — ESC가 별도로 들어오면 ESC 쪽이 덮어쓴다.
                    now = time.monotonic()
                    if now - self._last_esc_rpm_at > 1.0:
                        motor_rpms = []
                        motor_channels = list(ch[:4])
                        looks_like_pwm = any(abs(v) > 20.0 for v in motor_channels)
                        for i in range(4):
                            value = motor_channels[i] if i < len(motor_channels) else 0.0
                            if looks_like_pwm:
                                rpm = max(0.0, (value - 1000.0) * 10.0)
                            else:
                                rpm = max(0.0, min(1.0, value)) * 10000.0
                            motor_rpms.append(round(rpm, 0))
                        self.state["motorRpm"] = motor_rpms
                        self._last_motor_rpm_at = now
                    retries = 0
            except grpc.aio.AioRpcError as e:
                retries += 1
                if self.running:
                    if retries == 1 or retries % 10 == 0:
                        print(f"[REPORTER] Actuator stream lost ({e.code().name}), retrying...")
                    await asyncio.sleep(self.STREAM_RETRY_DELAY)
            except Exception as e:
                retries += 1
                if self.running:
                    if retries == 1 or retries % 10 == 0:
                        print(f"[REPORTER] Actuator stream error: {e}, retrying...")
                    await asyncio.sleep(self.STREAM_RETRY_DELAY)

    async def _sub_esc_status(self):
        """ESC RPM 스트림을 시도한다. ESC가 지원되면 PWM 추정치를 덮어쓴다."""
        retries = 0
        while self.running:
            try:
                async for esc in self.drone.telemetry.esc_status():
                    if not self.running: return
                    rpms = [float(info.rpm) for info in esc.esc_info[:4]]
                    while len(rpms) < 4:
                        rpms.append(0.0)
                    now = time.monotonic()
                    if any(r > 0 for r in rpms):
                        self.state["motorRpm"] = rpms
                        self._last_esc_rpm_at = now
                        self._last_motor_rpm_at = now
                    elif now - self._last_esc_rpm_at > 1.0:
                        self.state["motorRpm"] = rpms
                        self._last_motor_rpm_at = now
                    retries = 0
            except Exception as e:
                # ESC 미지원 기체라면 여기서 조용히 빠져나감
                retries += 1
                if self.running and (retries == 1 or retries % 10 == 0):
                    print(f"[REPORTER] ESC RPM stream unavailable: {e}, retrying...")
                await asyncio.sleep(self.STREAM_RETRY_DELAY * 2)

    async def _telemetry_loop(self):
        while self.running:
            payload = {
                "aircraftId": AIRCRAFT_ID,
                "flightPlanNumber": FLIGHT_PLAN_NUMBER,
                "ts": datetime.now(timezone.utc).isoformat(),
                "missionState": self.state["missionState"],
                "phase": self.state["phase"],
                "seq": self.state["seq"],
                "position": self.state["position"],
                "attitude": self.state["attitude"],
                "velocityNed": self.state.get("velocityNed", {"north": 0.0, "east": 0.0, "down": 0.0}),
                "speedMps": self.state.get("speedMps", 0.0),
                "actuator": self.state.get("actuator", {}),
                "motorRpm": self.state.get("motorRpm", [0.0, 0.0, 0.0, 0.0]),
            }
            await asyncio.get_running_loop().run_in_executor(None, self._send_sync, "/api/v1/telemetry", payload)
            await asyncio.sleep(0.1)  # 10Hz

    def start(self):
        self.running = True
        asyncio.create_task(self._configure_telemetry_rates())
        asyncio.create_task(self._sub_position())
        asyncio.create_task(self._sub_velocity())
        asyncio.create_task(self._sub_attitude())
        asyncio.create_task(self._sub_actuator())
        asyncio.create_task(self._sub_esc_status())
        asyncio.create_task(self._telemetry_loop())

    def stop(self):
        self.running = False


def _time_to_seconds(value: str) -> int:
    hour, minute, second = (int(part) for part in value.strip().split(":"))
    return hour * 3600 + minute * 60 + second


def _fetch_simulation_time_sync():
    last_error = None
    for base_url in VFDS_URLS:
        try:
            with urllib.request.urlopen(f"{base_url}/api/v1/time", timeout=1.0) as response:
                payload = json.loads(response.read().decode("utf-8"))
            if isinstance(payload.get("seconds"), int):
                return payload.get("time"), payload["seconds"]
            if isinstance(payload.get("time"), str):
                return payload["time"], _time_to_seconds(payload["time"])
        except Exception as exc:
            last_error = exc
    return None, last_error


async def wait_for_simulation_time(target_time: str, poll_sec: float = 0.2, reason: str = "target"):
    """Wait until the VFDS simulation clock reaches target_time."""
    target_seconds = _time_to_seconds(target_time)
    print(f"[TIME] Waiting for simulation time {target_time} ({reason}, {MISSION_START_FIELD})...")
    last_printed = None

    while True:
        current, error = await asyncio.get_running_loop().run_in_executor(None, _fetch_simulation_time_sync)
        if isinstance(current, str):
            current_seconds = _time_to_seconds(current)
            if current != last_printed:
                print(f"[TIME] Simulation time: {current} / target: {target_time}")
                last_printed = current
            if current_seconds >= target_seconds:
                print(f"[TIME] Simulation target reached: {current} ({reason}).")
                return
        elif last_printed != "unavailable":
            print(f"[TIME] Simulation time unavailable from VFDS yet: {error}")
            last_printed = "unavailable"

        await asyncio.sleep(poll_sec)


async def wait_for_stable_attitude(drone, timeout_sec: float = 15.0):
    """Wait until attitude telemetry looks sane before arming/takeoff."""
    import grpc
    print(f"[INIT] Waiting for stable attitude (timeout: {timeout_sec:.0f}s)...")
    deadline = asyncio.get_running_loop().time() + timeout_sec
    stable_samples = 0

    try:
        async for att in drone.telemetry.attitude_euler():
            values = (att.roll_deg, att.pitch_deg, att.yaw_deg)
            finite = all(math.isfinite(v) for v in values)
            level = abs(att.roll_deg) <= 15.0 and abs(att.pitch_deg) <= 15.0

            if finite and level:
                stable_samples += 1
                if stable_samples >= 10:
                    print(
                        f"[INIT] Attitude stable: roll={att.roll_deg:.2f}, "
                        f"pitch={att.pitch_deg:.2f}, yaw={att.yaw_deg:.2f}"
                    )
                    return
            else:
                stable_samples = 0

            if asyncio.get_running_loop().time() >= deadline:
                print(
                    f"[WARN] Attitude did not fully stabilize before timeout. "
                    f"Last sample roll={att.roll_deg:.2f}, pitch={att.pitch_deg:.2f}, yaw={att.yaw_deg:.2f}"
                )
                return
    except grpc.aio.AioRpcError as e:
        print(f"[WARN] Attitude stream error during init: {e.code().name}. Proceeding anyway...")
    except Exception as e:
        print(f"[WARN] Attitude check error: {e}. Proceeding anyway...")

